# Copy to .env.local for local development:  cp .env.example .env.local

# Where the browser reaches the FastAPI backend. NEXT_PUBLIC_ because the guest
# camera calls it directly from the device; nothing is proxied through Next.js.
#
# This must be a host the *phone* can resolve. Testing on a real device over the
# venue wifi means using the machine's LAN address rather than localhost, and
# adding that same origin to CORS_ORIGINS in the backend .env.
NEXT_PUBLIC_API_URL=http://localhost:8000
