# Copy to .env for local development:  cp .env.example .env
#
# Every external dependency is a URL. Moving to production means changing the
# values below, not the code.

# ---------------------------------------------------------------- application
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000

# Signs guest and host tokens. Generate a real one for anything but local:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me

# Origins allowed to call the API (Next.js dev server, Expo dev client)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Where a scanned QR code sends a guest. The API builds join URLs and QR codes
# from this, so printed cards and the app cannot disagree about the destination.
# Testing on a real phone means the machine's LAN address, not localhost.
PUBLIC_WEB_URL=http://localhost:3000

# ------------------------------------------------------------------- postgres
POSTGRES_USER=filmroll
POSTGRES_PASSWORD=filmroll
POSTGRES_DB=filmroll

# Async driver for the app. Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://filmroll:filmroll@db:5432/filmroll
# Sync driver for Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg://filmroll:filmroll@db:5432/filmroll

# ---------------------------------------------------------------------- redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -------------------------------------------------------------------- storage
# S3 API only, so MinIO locally and R2/S3 in production are interchangeable.
#
# Two endpoints on purpose. The API signs URLs that a phone browser will open,
# so those must be signed against a host the phone can resolve. Workers talk to
# storage over the compose network instead. Signing everything with the internal
# name produces URLs that fail in the browser, which is a confusing failure.
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

S3_ACCESS_KEY_ID=filmroll
S3_SECRET_ACCESS_KEY=filmroll-dev-secret
S3_BUCKET=filmroll-shots
S3_REGION=us-east-1
# MinIO requires path-style addressing. R2 and S3 accept it too.
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------- lifetimes
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=300
# A reserved shot that is never uploaded is reclaimed after this long.
RESERVATION_TTL_MINUTES=30

# ---------------------------------------------------------------------- abuse
# A presigned PUT names the key and content type but cannot bound the body, so
# the size is checked on commit and anything oversized is deleted immediately.
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,image/heic

# Fixed windows. Joins are limited per address, reservations per guest, because
# a venue puts every phone behind one NAT.
RATE_LIMIT_JOIN_PER_HOUR=20
RATE_LIMIT_RESERVE_PER_MINUTE=30

# ------------------------------------------------------------------- billing
# The price list lives in code, not the Stripe dashboard. Checkout always
# sends price_data built from that catalog.
#
# Local default is fake Checkout: paying for a larger room grants the cap
# immediately with no API key. Production ignores BILLING_FAKE even if it is
# still true, and refuses Checkout until STRIPE_SECRET_KEY is set.
# Webhook endpoint: POST /v1/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
BILLING_FAKE=true
