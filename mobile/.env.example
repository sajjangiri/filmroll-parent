# Copy to .env for Expo:  cp .env.example .env
#
# The phone talks to FastAPI directly. localhost only works in the iOS
# simulator; a physical device needs the machine's LAN address, and that
# origin does not need to be in CORS_ORIGINS (CORS is a browser rule).
#
# EXPO_PUBLIC_WEB_URL is where hosts create films (shown on the home screen).
# On a physical device, use the same LAN address as EXPO_PUBLIC_API_URL.

EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
